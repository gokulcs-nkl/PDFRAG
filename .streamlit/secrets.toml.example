# Secrets for a hosted deployment (Streamlit Community Cloud).
# Paste these keys into the app's Settings -> Secrets box with your own
# values. Never commit a real secrets.toml (it is gitignored).

# Any OpenAI-compatible chat API. Setting LLM_API_KEY switches the app
# from local Ollama to this API.
LLM_API_KEY = "your-api-key"
LLM_BASE_URL = "https://api.groq.com/openai/v1"
LLM_MODEL = "openai/gpt-oss-20b"
