# --- Option A: local Ollama (default; no API key, data stays on-machine) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# --- Option B: hosted OpenAI-compatible API (needed for cloud hosting) ---
# Setting LLM_API_KEY switches the app to this API instead of Ollama.
# Works with Groq, Gemini, OpenRouter, ... - change the base URL and model.
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# Force a provider regardless of the key: ollama | openai
# LLM_PROVIDER=ollama
